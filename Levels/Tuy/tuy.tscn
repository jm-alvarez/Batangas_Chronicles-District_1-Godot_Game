[node name="npc" parent="." instance=ExtResource("9_dtwso")]
position = Vector2(-2113, -403.07428)
npc_resource = ExtResource("16_h48ys")

[node name="dialog_interaction" parent="npc" instance=ExtResource("12_d12pr")]

[node name="1loctxt" type="Node" parent="npc/dialog_interaction"]
script = ExtResource("12_npxw3")
text = "This tree looks ancient. Has it always been here?"
npc_info = ExtResource("16_h48ys")
metadata/_custom_type_script = "uid://6rr3xn6vbfwp"

[node name="2akitxt" type="Node" parent="npc/dialog_interaction"]
script = ExtResource("12_npxw3")
text = "Ah… not this exact one. 
But trees like this once filled this land long ago."
npc_info = ExtResource("17_lepok")
metadata/_custom_type_script = "uid://6rr3xn6vbfwp"

[node name="3loctxt" type="Node" parent="npc/dialog_interaction"]
script = ExtResource("12_npxw3")
text = "Really? 
What kind of trees?"
npc_info = ExtResource("16_h48ys")
metadata/_custom_type_script = "uid://6rr3xn6vbfwp"

[node name="4akitxt" type="Node" parent="npc/dialog_interaction"]
script = ExtResource("12_npxw3")
text = "They were called [color=red]tuy[/color]. 
A white, light wood tree. Strong, but easy to carve. People used it to make wooden shoes."
npc_info = ExtResource("17_lepok")
metadata/_custom_type_script = "uid://6rr3xn6vbfwp"

[node name="5loctxt" type="Node" parent="npc/dialog_interaction"]
script = ExtResource("12_npxw3")
text = "So… is that how this town got its name?"
npc_info = ExtResource("16_h48ys")
metadata/_custom_type_script = "uid://6rr3xn6vbfwp"

[node name="6akitxt" type="Node" parent="npc/dialog_interaction"]
script = ExtResource("12_npxw3")
text = "[wave]Haha[/wave]That’s what many believe. When the Spaniards first came here, they asked a native man the name of this place."
npc_info = ExtResource("17_lepok")
metadata/_custom_type_script = "uid://6rr3xn6vbfwp"

[node name="7loctxt" type="Node" parent="npc/dialog_interaction"]
script = ExtResource("12_npxw3")
text = " And?"
npc_info = ExtResource("16_h48ys")
metadata/_custom_type_script = "uid://6rr3xn6vbfwp"

[node name="8akitxt" type="Node" parent="npc/dialog_interaction"]
script = ExtResource("12_npxw3")
text = "The Spaniard asked in Spanish. The native didn’t understand. He thought the foreigner was asking about the tree he was resting under."
npc_info = ExtResource("17_lepok")
metadata/_custom_type_script = "uid://6rr3xn6vbfwp"

[node name="9loctxt" type="Node" parent="npc/dialog_interaction"]
script = ExtResource("12_npxw3")
text = "Let me guess… he answered “tuy”?"
npc_info = ExtResource("16_h48ys")
metadata/_custom_type_script = "uid://6rr3xn6vbfwp"

[node name="10akitxt" type="Node" parent="npc/dialog_interaction"]
script = ExtResource("12_npxw3")
text = "Exactly. The Spaniard believed that was the name of the place. From then on, they began calling it [shake]Tuy[/shake]."
npc_info = ExtResource("17_lepok")
metadata/_custom_type_script = "uid://6rr3xn6vbfwp"

[node name="11loctxt" type="Node" parent="npc/dialog_interaction"]
script = ExtResource("12_npxw3")
text = "So the town was named because of a misunderstanding?"
npc_info = ExtResource("16_h48ys")
metadata/_custom_type_script = "uid://6rr3xn6vbfwp"

[node name="12akitxt" type="Node" parent="npc/dialog_interaction"]
script = ExtResource("12_npxw3")
text = "Sometimes history is written by confusion, not intention."
npc_info = ExtResource("17_lepok")
metadata/_custom_type_script = "uid://6rr3xn6vbfwp"

